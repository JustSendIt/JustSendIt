# ── JustSendIt environment ─────────────────────────────────────────────
# Copy to `.env` and fill in for a VPS/systemd deploy, OR set these directly
# in your host's dashboard (Fly/Render/Railway). Real env vars override the file.

# ── Required in production ──────────────────────────────────────────────
# Your public https origin. Drives OAuth redirect URLs, every absolute SEO /
# share URL (canonical, og:*, sitemap, robots), the CSRF origin check and the
# Secure cookie flag. MUST be your real domain in production.
BASE_URL=https://yourdomain.com

# Encryption-at-rest key for personal data (emails, wallet links, 2FA secrets,
# tracked wallets, tracker reports, IPs). 64 hex chars — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back it up somewhere the DB backups are NOT. If unset, a key is generated
# into data/.data_key on first boot (fine for local, not for production).
DATA_KEY=

# Marks this as a production process: turns on the boot-time misconfiguration
# warnings (BASE_URL / COOKIE_SECURE / TRUST_PROXY). Any of an https BASE_URL,
# COOKIE_SECURE=1 or TRUST_PROXY also count as a production signal.
NODE_ENV=production

# Port the Node process listens on (your reverse proxy / platform points here).
PORT=8642

# Set to 1 when TLS is terminated by a proxy/platform in front of Node, so
# session cookies are still marked Secure even though Node itself speaks http.
COOKIE_SECURE=1

# Set to 1 when behind a reverse proxy (Caddy/nginx/Cloudflare/LB) so rate
# limits key on the real client IP from X-Forwarded-For, not the proxy.
TRUST_PROXY=1

# ── Optional: social login (each provider is auto-enabled only if BOTH set) ─
# Register the app with each provider and set the redirect/callback URL to:
#   https://yourdomain.com/api/auth/<provider>/callback
# e.g. https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# ── Optional: fiat on-ramp (the "Buy" widget) ──────────────────────────
# Without this the site falls back to MoonPay's generic public buy page.
MOONPAY_API_KEY=

# ── Optional: Dextools "paid/updated" indicator on Live New Pairs ───────
# Dexscreener branding (logo, banner, socials, "Enhanced ✓" / "Boosted ⚡") works with NO key.
# Dextools status can't be detected for free — it needs Dextools' paid API AND the token's chain must be
# listed on Dextools (Robinhood Chain may not be). Set BOTH of these to light up the Dextools indicator;
# leave them blank and it honestly shows "not connected" (no network calls are made).
DEXTOOLS_API_KEY=
DEXTOOLS_CHAIN=          # the Dextools chain slug for Robinhood Chain, once known (e.g. "ether" for Ethereum)
