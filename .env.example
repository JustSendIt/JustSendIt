# ── JustSendIt environment ─────────────────────────────────────────────
# Copy to `.env` and fill in for a VPS/systemd deploy, OR set these directly
# in your host's dashboard (Fly/Render/Railway). Real env vars override the file.

# ── Required in production ──────────────────────────────────────────────
# Your public https origin. Drives OAuth redirect URLs, every absolute SEO /
# share URL (canonical, og:*, sitemap, robots), the CSRF origin check and the
# Secure cookie flag. MUST be your real domain in production.
BASE_URL=https://sendrh.com

# Encryption-at-rest key for personal data (emails, wallet links, 2FA secrets,
# tracked wallets, tracker reports, IPs). 64 hex chars — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back it up somewhere the DB backups are NOT. If unset, a key is generated
# into data/.data_key on first boot (fine for local). In production the app REFUSES TO START without
# this set — generating a key there would either hide it inside the same volume as the data it protects,
# or, if the volume failed to mount, start an empty database and serve it as if it were the site.
DATA_KEY=
# Or keep the key in a file of its own, on a different volume from the database AND from the backups (chmod 600).
# Named and unreadable (the volume did not mount) is a refusal to start, never a fallback to another key.
# DATA_KEY_FILE=/Volumes/JustSendItKey/data_key
# The file can also hold a KEYRING (node scripts/keys.mjs init, server stopped), which rotates: see DEPLOY.md → Key rotation.
# KEY_ROTATE_HOURS=24          # a new data key this often; everything is re-encrypted, the old key dropped (0 = off)
# IDX_ROTATE_DAYS=7            # a new index key this often, at KEY_ROTATE_HOUR (restarts the server for ~10 s; 0 = off)
# KEY_ROTATE_HOUR=4            # server-local hour for the index rotation
# KEY_DROP_GRACE_MIN=60        # how long an old data key is kept after nothing needs it
# KEY_ROTATE_EXTRA_DBS=        # more database COPIES to bring along at every rotation (files or folders, comma-separated; never a database a running server has open)
# KEY_ROTATE_WITHOUT_ESCROW=1  # rotate even though `scripts/keys.mjs escrow-init` has not been run (the ring is then the only copy)

# Marks this as a production process: turns on the boot-time misconfiguration
# warnings (BASE_URL / COOKIE_SECURE / TRUST_PROXY). Any of an https BASE_URL,
# COOKIE_SECURE=1 or TRUST_PROXY also count as a production signal.
NODE_ENV=production

# Port the Node process listens on (your reverse proxy / platform points here).
PORT=8642

# Set to 1 when TLS is terminated by a proxy/platform in front of Node, so
# session cookies are still marked Secure even though Node itself speaks http.
COOKIE_SECURE=1

# Bind address. Defaults to 127.0.0.1 — Node is meant to sit behind a reverse proxy on the same box.
# Set 0.0.0.0 only when the platform's proxy reaches it over the network (Fly, Docker) and nothing else can.
HOST=127.0.0.1

# How many proxies APPEND to X-Forwarded-For before a request reaches Node. That is the number of hops
# the app walks back from the end of the header to find the real client:
#   Caddy or nginx alone ............... 1
#   Cloudflare in front of Caddy/nginx .. 2   (Cloudflare adds one address, Caddy adds one)
# Get it wrong and every rate limit and anti-sybil cap keys on a proxy address. The header is only
# believed when the TCP peer is one of our own proxies (TRUST_PROXY_FROM); a request that reaches Node
# directly cannot pick its own address. The app warns at boot when the hop count looks wrong.
TRUST_PROXY=1
# Which peers may speak for the client: loopback,private (default), a CIDR, an address, or any.
TRUST_PROXY_FROM=loopback,private
# Behind Cloudflare only: read CF-Connecting-IP from a trusted peer instead of walking X-Forwarded-For.
TRUST_CF=0

# The seed invite code: the only key to the only door on a fresh deploy, and it mints accounts.
# Unset, the server generates a random one and prints it ONCE at boot (read the log); set it to choose it.
# It is seeded only while the invite table is empty — once anyone is in, it never reappears, and seed codes stop
# admitting anyone: from the first member on, only the codes members were given (INVITE_GRANT each) open the door.
# SEED_CODES_OPEN=1 keeps seed codes working (the test suite sets it; a live site should not).
SEED_INVITE_CODE=

# The admin account(s): who may open /admin (overview + moderation queue) — everyone else gets a 404 for the page,
# its script and every /api/admin route. Comma-separated database row ids (users.id — not the Send ID a member sees).
# Nobody by default.
ADMIN_USER_IDS=

# --- Chain data endpoints -------------------------------------------------
# Both default to the public keyless hosts, and both of those refuse a server at launch volume:
#   * the public RPC answers 429 to eth_call after a handful of rapid reads, and Robinhood's own docs
#     call it "rate-limited and not recommended for production use". Alchemy serves chain 4663:
#     RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/<key>
#   * the public explorer answers 403 with a Cloudflare bot challenge to a server request, and the site does not
#     try to get past one: with BLOCKSCOUT_URL unset its API is not asked at all (owner, 2026-10-27). Holder counts
#     then come from the chain's own holder ledger and GoPlus, contract flags from GoPlus, the deployer from GoPlus,
#     the deployer's trades and community holder snapshots from the chain — and what only the explorer gives (its
#     verified source as a second opinion, the contract's name, a token GoPlus has never read) is said as not read.
#     A free key from dev.blockscout.com gives a host that answers: BLOCKSCOUT_URL=https://...
RPC_URL=
BLOCKSCOUT_URL=
# The Scanner also reads Ethereum and Solana tokens (owner, 2026-10-23; lib/multichain.js). Every pool, price and trade
# comes from Dexscreener; holders, verification, ownership, taxes and the honeypot verdict (Ethereum) and the mint /
# freeze authorities, transfer fees and LP burn (Solana) from GoPlus; candles and the tape from GeckoTerminal; name,
# symbol, decimals and supply from the chain's own node. The nodes default to keyless public endpoints, which answer the
# handful of small reads this makes (measured 2026-10-23: publicnode for Ethereum, api.mainnet-beta.solana.com); a keyed
# endpoint goes here when volume asks for one. The MC_* bases exist so the test suites can point every read at a fake.
ETH_RPC_URL=
SOL_RPC_URL=
MC_DEXSCREENER_URL=
MC_GECKO_URL=
MC_GOPLUS_URL=
# The Swap in my wallet button (every token's detail): Solana swaps are quoted and built by Jupiter's swap API. Keyless it allows
# half a request a second; a key from portal.jup.ag raises that (sent as x-api-key). JUPITER_URL exists so the test suites can fake it.
JUPITER_API_KEY=
JUPITER_URL=

# --- Market Data (/market, the Send API's market resources, the admin page's Collected data) ---------------
# The collectors that keep the market tables warm (chains every 30 min, chain histories every 6 h, pools every 10 min,
# new pools every 3 min, the Robinhood Chain pulse every minute, the New Pairs radar every 10 min, the most-scanned tokens
# hourly) run in production and nowhere else unless this is 1. The test suites leave it unset and call a collector directly.
MARKET_COLLECT=
# Every source is read from its public keyless host by default, with the honest User-Agent "JustSendIt/1.0 (+https://sendrh.com)" —
# the one identity every request this server makes carries, never a browser's —
# each within its own OUTBOUND_RPM meter. These bases exist so the test suites can point every read at a fake (tests/run.mjs
# sets them to a dead address); leave them empty on a real deploy. (A note goes on its own line: after an empty value, a
# "# note" would be read as the value.)
#   MARKET_LLAMA_URL          DefiLlama (api.llama.fi): chains, TVL, DEX volume, fees, open interest
#   MARKET_LLAMA_COINS_URL    DefiLlama coins (coins.llama.fi): its relay of CoinGecko's market caps (the stand-in when CoinGecko cannot be read)
#   MARKET_LLAMA_STABLES_URL  DefiLlama stablecoins (stablecoins.llama.fi)
#   MARKET_L2BEAT_URL         L2BEAT (l2beat.com): value secured, stage, risks, activity
#   MARKET_GROWTHEPIE_URL     growthepie (api.growthepie.com): CC BY 4.0; publishes a ceiling of 10 calls a minute
#   MARKET_GT_URL             GeckoTerminal (api.geckoterminal.com): 10 a minute for the WHOLE site; Market Data's collectors
#                             take at most 3, and 2 more are kept for people opening a token (the collectors never use those)
#   MARKET_DS_URL             Dexscreener (api.dexscreener.com): search, a token's links and picture
#   MARKET_CG_URL             CoinGecko (api.coingecko.com): keyless is fragile — at most one call every 2 minutes, cached 5+
#                             (each chains run reads its chain tokens' market caps once; its asset platforms once a day)
#   MARKET_COINLORE_URL       CoinLore (api.coinlore.net/api): the chain market caps' second source, checked against CoinGecko's
#                             (a daily walk of its list, at most 20 pages, then one read per chains run; ≥1.1 s between calls).
#                             Leave it unset for CoinLore; set it EMPTY to turn CoinLore off (the market caps then say so).
#                             Not CoinPaprika: its free plan is for personal use only (showing its data needs a paid licence).
#   MARKET_ETH_RPC_URL        an Ethereum node for the canonical bridge's balance (default: publicnode's, already metered)
MARKET_LLAMA_URL=
MARKET_LLAMA_COINS_URL=
MARKET_LLAMA_STABLES_URL=
MARKET_L2BEAT_URL=
MARKET_GROWTHEPIE_URL=
MARKET_GT_URL=
MARKET_DS_URL=
MARKET_CG_URL=
MARKET_ETH_RPC_URL=
# MARKET_COINLORE_URL=      (commented out on purpose: an empty value turns CoinLore off)
# Optional: a free CoinGecko Demo key (coingecko.com/en/api) — sent as the x-cg-demo-api-key header; without one the keyless tier is used.
COINGECKO_DEMO_KEY=
# The chain's explorer (robinhoodchain.blockscout.com) answers a server with a Cloudflare challenge, and the site never tries
# to get past it. BLOCKSCOUT_URL above, pointed at a keyed endpoint (a free key from dev.blockscout.com), is the honest route
# to its counters and holder lists; unset, nothing on the site asks it, and Market Data reads the chain itself and the sources
# above instead.

# --- Outbound request budget --------------------------------------------
# Every third-party JSON read is metered per host against the vendor's PUBLISHED limit, so the site waits
# for its own budget instead of being cut off by theirs. Defaults: api.dexscreener.com 270/min (their
# 300/min, at 90%), api.coingecko.com 20/min, a keyed explorer 240/min (the keyed tier's 5/s). When you buy a
# higher tier, raise the ceiling here — host upper-cased, dots as underscores:
#   OUTBOUND_RPM_API_DEXSCREENER_COM=1000
# A call that would have to wait longer than this is answered "could not ask" instead of queueing forever.
OUTBOUND_MAX_WAIT_MS=15000

# --- Holder counts and contract-power flags -------------------------------
# GoPlus Security supplies both (it lists Robinhood Chain, id 4663, in its own supported-chains response),
# and it answers a server with no key at all: holder_count, the top ten holders with their share, plus
# mintable / pausable / blacklist / whitelist / anti-whale / cooldown / take-back-ownership / hidden-owner
# / honeypot / buy-sell tax. Free tier is 30 calls a minute. A paid plan sends a key here and raises the
# meter with OUTBOUND_RPM_API_GOPLUSLABS_IO.
# These are one vendor's automated readings, not an audit, and the site says so where they are shown.
GOPLUS_KEY=
GOPLUS_CHAIN=4663

# --- When the beta ends ----------------------------------------------------
# The beta's end is its own date, and the OG calendar hangs off it: GOLD closes when the beta ends and
# SILVER ninety days after that (BRONZE is one year from $GWC's launch and does not move). Unset, it is
# the date already published to users, 2026-11-17. An ISO date or epoch ms; moving it moves gold and
# silver with it, and the countdowns on the site follow because no deadline is hard-coded in the pages.
BETA_END=

# Behind Cloudflare: lets a takedown or account deletion purge the removed upload's URL from the edge.
# Without these, /uploads is cached for a day at most.
CF_ZONE_ID=
CF_API_TOKEN=

# ── Optional: social login (each provider is auto-enabled only if BOTH set) ─
# Register the app with each provider and set the redirect/callback URL to:
#   https://sendrh.com/api/auth/<provider>/callback
# e.g. https://sendrh.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# ── Optional: fiat on-ramp (the "Buy" widget) ──────────────────────────
# Without this the site falls back to MoonPay's generic public buy page.
MOONPAY_API_KEY=

# ── Optional: Dextools "paid/updated" indicator on Live New Pairs ───────
# Dexscreener branding (logo, banner, socials, "Enhanced ✓" / "Boosted ⚡") works with NO key.
# Dextools status can't be detected for free — it needs Dextools' paid API AND the token's chain must be
# listed on Dextools (Robinhood Chain may not be). Set BOTH of these to light up the Dextools indicator;
# leave them blank and it honestly shows "not connected" (no network calls are made).
DEXTOOLS_API_KEY=
# The Dextools chain slug for Robinhood Chain, once known (e.g. "ether" for Ethereum). The note sits on its own line: after an
# empty value the server's .env reader would take "# the …" as the value itself.
DEXTOOLS_CHAIN=

# ── Sendy, the helper in the corner (optional) ───────────────────────────
# Sendy's brain (lib/sendybrain.js) answers with or without a key: an index of everything public the site has
# written (README §1-4, the pages, the white paper, the Support board, public posts and calls, communities,
# answers readers rated helpful), kept up in the background, and read-only tools over the live public data
# (Market Data, the Scanner's readings, the boards, a member's public profile, the counts).
# Without a key, the brain answers on its own — figures with their source and age, the page to go to, a person
# when nothing fits — and nothing leaves the server.
# With a key, Claude answers through Anthropic's SDK with the same tools: the question, its page and the last few
# turns of that chat go to Anthropic with the site's public text — nothing about the account (Privacy Policy §8).
# Rate-limited per address and site-wide: with a key every answer is a paid call.
ANTHROPIC_API_KEY=
# The model Sendy answers with (default claude-opus-5-5).
SENDY_MODEL=
# Where the SDK sends its requests (default https://api.anthropic.com; the tests point it at a local fake).
# A shell's ANTHROPIC_BASE_URL is never used: the server always gives the SDK this one.
SENDY_API_URL=
# How often the brain reads what is new, in ms (default 60000), and the whole time one question may take
# with the model, in ms (default 40000; after it, the brain's own answer is given).
SENDY_REFRESH_MS=
SENDY_DEADLINE_MS=

# ── Telegram scanner bot (optional) ─────────────────────────────────────
# Lets anyone add the token scanner to their own Telegram group. Get a token
# from @BotFather (/newbot), paste it here, restart. Leave blank and the bot
# simply does not run — the site is unaffected.
#
# With an https BASE_URL the bot registers a webhook automatically. Without one
# (local dev, no domain yet) it long-polls instead, which needs no public URL.
# The webhook secret is derived from this token; there is nothing else to set.
#
# In @BotFather, also run /setjoingroups to allow groups, and leave privacy mode
# ON (the default) so the bot only ever sees messages addressed to it.
TELEGRAM_BOT_TOKEN=
