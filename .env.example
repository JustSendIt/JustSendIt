# ── JustSendIt environment ─────────────────────────────────────────────
# Copy to `.env` and fill in for a VPS/systemd deploy, OR set these directly
# in your host's dashboard (Fly/Render/Railway). Real env vars override the file.

# ── Required in production ──────────────────────────────────────────────
# Your public https origin. Drives OAuth redirect URLs, every absolute SEO /
# share URL (canonical, og:*, sitemap, robots), the CSRF origin check and the
# Secure cookie flag. MUST be your real domain in production.
BASE_URL=https://sendrh.com

# Encryption-at-rest key for personal data (emails, wallet links, 2FA secrets,
# tracked wallets, tracker reports, IPs). 64 hex chars — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back it up somewhere the DB backups are NOT. If unset, a key is generated
# into data/.data_key on first boot (fine for local). In production the app REFUSES TO START without
# this set — generating a key there would either hide it inside the same volume as the data it protects,
# or, if the volume failed to mount, start an empty database and serve it as if it were the site.
DATA_KEY=

# Marks this as a production process: turns on the boot-time misconfiguration
# warnings (BASE_URL / COOKIE_SECURE / TRUST_PROXY). Any of an https BASE_URL,
# COOKIE_SECURE=1 or TRUST_PROXY also count as a production signal.
NODE_ENV=production

# Port the Node process listens on (your reverse proxy / platform points here).
PORT=8642

# Set to 1 when TLS is terminated by a proxy/platform in front of Node, so
# session cookies are still marked Secure even though Node itself speaks http.
COOKIE_SECURE=1

# Bind address. Defaults to 127.0.0.1 — Node is meant to sit behind a reverse proxy on the same box.
# Set 0.0.0.0 only when the platform's proxy reaches it over the network (Fly, Docker) and nothing else can.
HOST=127.0.0.1

# How many proxies APPEND to X-Forwarded-For before a request reaches Node. That is the number of hops
# the app walks back from the end of the header to find the real client:
#   Caddy or nginx alone ............... 1
#   Cloudflare in front of Caddy/nginx .. 2   (Cloudflare adds one address, Caddy adds one)
# Get it wrong and every rate limit and anti-sybil cap keys on a proxy address. The header is only
# believed when the TCP peer is one of our own proxies (TRUST_PROXY_FROM); a request that reaches Node
# directly cannot pick its own address. The app warns at boot when the hop count looks wrong.
TRUST_PROXY=1
# Which peers may speak for the client: loopback,private (default), a CIDR, an address, or any.
TRUST_PROXY_FROM=loopback,private
# Behind Cloudflare only: read CF-Connecting-IP from a trusted peer instead of walking X-Forwarded-For.
TRUST_CF=0

# The seed invite code: the only key to the only door on a fresh deploy, and it mints accounts.
# Unset, the server generates a random one and prints it ONCE at boot (read the log); set it to choose it.
# It is seeded only while the invite table is empty — once anyone is in, it never reappears.
SEED_INVITE_CODE=

# Operators who may use the moderation queue (/admin.html): comma-separated user ids. Nobody by default.
ADMIN_USER_IDS=

# --- Chain data endpoints -------------------------------------------------
# Both default to the public keyless hosts, and both of those refuse a server at launch volume:
#   * the public RPC answers 429 to eth_call after a handful of rapid reads, and Robinhood's own docs
#     call it "rate-limited and not recommended for production use". Alchemy serves chain 4663:
#     RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/<key>
#   * the public explorer answers 403 with a Cloudflare bot challenge to a server request, so holder
#     counts, top-holder concentration and contract-power flags all read as unknown. A free key from
#     dev.blockscout.com gives a host that answers: BLOCKSCOUT_URL=https://...
RPC_URL=
BLOCKSCOUT_URL=

# --- Outbound request budget --------------------------------------------
# Every third-party JSON read is metered per host against the vendor's PUBLISHED limit, so the site waits
# for its own budget instead of being cut off by theirs. Defaults: api.dexscreener.com 270/min (their
# 300/min, at 90%), api.coingecko.com 20/min, the explorer 240/min (the keyed tier's 5/s). When you buy a
# higher tier, raise the ceiling here — host upper-cased, dots as underscores:
#   OUTBOUND_RPM_API_DEXSCREENER_COM=1000
# A call that would have to wait longer than this is answered "could not ask" instead of queueing forever.
OUTBOUND_MAX_WAIT_MS=15000

# --- Holder counts and contract-power flags -------------------------------
# GoPlus Security supplies both (it lists Robinhood Chain, id 4663, in its own supported-chains response),
# and it answers a server with no key at all: holder_count, the top ten holders with their share, plus
# mintable / pausable / blacklist / whitelist / anti-whale / cooldown / take-back-ownership / hidden-owner
# / honeypot / buy-sell tax. Free tier is 30 calls a minute. A paid plan sends a key here and raises the
# meter with OUTBOUND_RPM_API_GOPLUSLABS_IO.
# These are one vendor's automated readings, not an audit, and the site says so where they are shown.
GOPLUS_KEY=
GOPLUS_CHAIN=4663

# --- When the beta ends ----------------------------------------------------
# The beta's end is its own date, and the OG calendar hangs off it: GOLD closes when the beta ends and
# SILVER ninety days after that (BRONZE is one year from $GWC's launch and does not move). Unset, it is
# the date already published to users, 2026-11-17. An ISO date or epoch ms; moving it moves gold and
# silver with it, and the countdowns on the site follow because no deadline is hard-coded in the pages.
BETA_END=

# Behind Cloudflare: lets a takedown or account deletion purge the removed upload's URL from the edge.
# Without these, /uploads is cached for a day at most.
CF_ZONE_ID=
CF_API_TOKEN=

# ── Optional: social login (each provider is auto-enabled only if BOTH set) ─
# Register the app with each provider and set the redirect/callback URL to:
#   https://sendrh.com/api/auth/<provider>/callback
# e.g. https://sendrh.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# ── Optional: fiat on-ramp (the "Buy" widget) ──────────────────────────
# Without this the site falls back to MoonPay's generic public buy page.
MOONPAY_API_KEY=

# ── Optional: Dextools "paid/updated" indicator on Live New Pairs ───────
# Dexscreener branding (logo, banner, socials, "Enhanced ✓" / "Boosted ⚡") works with NO key.
# Dextools status can't be detected for free — it needs Dextools' paid API AND the token's chain must be
# listed on Dextools (Robinhood Chain may not be). Set BOTH of these to light up the Dextools indicator;
# leave them blank and it honestly shows "not connected" (no network calls are made).
DEXTOOLS_API_KEY=
DEXTOOLS_CHAIN=          # the Dextools chain slug for Robinhood Chain, once known (e.g. "ether" for Ethereum)

# ── Telegram scanner bot (optional) ─────────────────────────────────────
# Lets anyone add the token scanner to their own Telegram group. Get a token
# from @BotFather (/newbot), paste it here, restart. Leave blank and the bot
# simply does not run — the site is unaffected.
#
# With an https BASE_URL the bot registers a webhook automatically. Without one
# (local dev, no domain yet) it long-polls instead, which needs no public URL.
# The webhook secret is derived from this token; there is nothing else to set.
#
# In @BotFather, also run /setjoingroups to allow groups, and leave privacy mode
# ON (the default) so the bot only ever sees messages addressed to it.
TELEGRAM_BOT_TOKEN=
