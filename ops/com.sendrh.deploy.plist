<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SendRH.com follows GitHub (DEPLOY.md, "SendRH.com follows GitHub"). Nothing installs this by itself: a person runs
  ~/justsendit-live/ops/install-mac.sh with its yes option, which loads it HELD. (An XML comment cannot hold two
  dashes in a row, so the options are spelled out in words here; DEPLOY.md has them exactly.)

  Every 2 minutes it runs the deployer of the commit that is LIVE now (copied to a new file and renamed into place, so a
  tick never rewrites a file a running pass is still reading). It never runs a script straight from GitHub: new deploy
  steps run only after they passed npm test and went live through the steps before them. It restarts the LaunchAgent
  that serves the site, com.justsendit.server; it installs no second site agent. No SENDRH_* settings here on purpose:
  the scripts' defaults are this Mac's folders, and the test suite must never inherit a deployer's settings.

  Stop it: launchctl bootout gui/$(id -u)/com.sendrh.deploy
  Pause it: ~/justsendit-live/ops/auto-deploy.sh with its hold option, and the reason
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sendrh.deploy</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>D="$HOME/.config/sendrh-deploy"; mkdir -p "$D" &amp;&amp; cp "$HOME/justsendit-live/ops/auto-deploy.sh" "$D/pass.sh.$$" &amp;&amp; mv -f "$D/pass.sh.$$" "$D/pass.sh" &amp;&amp; exec /bin/bash "$D/pass.sh"</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/addison</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/addison/.nvm/versions/node/v24.21.0/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StartInterval</key>
  <integer>120</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/addison/Library/Logs/sendrh-deploy/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/addison/Library/Logs/sendrh-deploy/launchd.log</string>
</dict>
</plist>
